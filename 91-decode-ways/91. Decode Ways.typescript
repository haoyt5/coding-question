function numDecodings(s: string): number {
    let n = s.length;
    let prev1 = 1;
    let prev2 = 0;

    for (let i = n - 1; i >= 0; i--) {
        let curr = 0;
        if (s[i] !== "0" ) {
            curr += prev1;
        }

        if (i+ 1 < n) {
            const twoDigit = Number(s.substring(i, i+2));
            if (twoDigit >= 10 &&twoDigit <= 26) {
                curr += prev2;
            }
        }
        prev2 = prev1;
        prev1 = curr

    }
    return prev1;
};