function isValid(s: string): boolean {
    if (s.length % 2 !== 0) return false;
    const pairs: Map<string, string> = new Map([ ["(", ")"] ,["[","]"], ["{","}"]])
    const stack: string[] = [];
    for (const char of s) {
        if( pairs.has(char)) {
            stack.push(pairs.get(char))
        } else {
            if (stack.pop() !== char) return false;
        }

    }
    return stack.length === 0;
};