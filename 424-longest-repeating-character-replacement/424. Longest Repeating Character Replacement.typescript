function characterReplacement(s: string, k: number): number {
    // winLen - maxFreq <= k

    const counts = new Array(26).fill(0); // [a-z]
    let l: number = 0;
    let maxFreq: number = 0;
    let result: number = 0;
    for (let r = 0; r < s.length;r++) {
        const ri: number = s.charCodeAt(r) - 65;
        counts[ri]++;

        maxFreq = Math.max(maxFreq, counts[ri]);

        const winLen = r - l + 1;
        if (winLen - maxFreq > k) {
            counts[s.charCodeAt(l) - 65]--;
            l++;
        }
        result = Math.max(result, r - l + 1)
    }

    return result;

};