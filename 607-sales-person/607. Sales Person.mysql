# Write your MySQL query statement below
SELECT SalesPerson.name
FROM SalesPerson
WHERE SalesPerson.sales_id NOT IN (
    SELECT Orders.sales_id 
    FROM Orders
    LEFT JOIN Company on Orders.com_id = Company.com_id
    WHERE Company.name = "red")

