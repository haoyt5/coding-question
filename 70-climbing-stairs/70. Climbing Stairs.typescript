function climbStairs(n: number): number {
    if (n <= 2) return n;
    let prev: number = 1; // way(i-2)
    let curr: number = 2; // way(i-1)
    
    for(let i = 3; i <= n; i++) {
        let next: number = prev + curr; // way(i) = way(i-2)+way(i-1);
        prev = curr;
        curr = next;
    }
    return curr;
};