function largestRectangleArea(heights: number[]): number {
    let stack: number[] = []; // indecies store with increasing height;
    let maxArea: number = 0;
    const n: number = heights.length;

    for (let i = 0; i <= n; i++) {
        const currentH = i===n ? 0 : heights[i];

        while(stack.length > 0 && heights[stack[stack.length - 1]] > currentH) {
            let topHIdx: number = stack.pop();
            let h: number = heights[topHIdx];
            let w: number = stack.length === 0 ? i : i - stack[stack.length - 1] -1;
            maxArea = Math.max(maxArea, h*w);
        }
        stack.push(i);
    }
    return maxArea;
};