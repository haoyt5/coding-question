function pacificAtlantic(heights: number[][]): number[][] {
        const rows = heights.length;
        const cols = heights[0].length;

        const pacific: boolean[][] = Array.from({length: rows}, ()=> Array(cols).fill(false))
        const atlantic: boolean[][] = Array.from({length: rows}, ()=> Array(cols).fill(false))

        const dirs = [[0, -1], [0, 1], [1, 0], [-1, 0]];
        function bfs(queue, reachable) {
            while (queue.length > 0) {
                const [r, c] = queue.shift();
                for (const [dr, dc] of dirs) {
                    const nr = r + dr;
                    const nc = c + dc;
                    if (nr >= 0 && nr < rows && nc >= 0 && nc < cols && !reachable[nr][nc]&& heights[nr][nc] >= heights[r][c]) {
                        reachable[nr][nc] = true;
                        queue.push([nr, nc])
                    }
                }
            }
        }
        const pQueue: [number, number][] = [];
        const aQueue: [number, number][] = [];

        for (let r = 0; r < rows; r++) {
            pQueue.push([r, 0]);
            pacific[r][0] = true;

            aQueue.push([r, cols-1]);
            atlantic[r][cols - 1] = true;
            
        }
        for (let c = 0; c < cols; c++) {
            pQueue.push([0, c]);
            pacific[0][c] = true;
            
            aQueue.push([rows-1, c]);
            atlantic[rows -1][c] = true;
            
        }
        bfs(pQueue, pacific);   // ← add
        bfs(aQueue, atlantic);  // ← add
        const results: number[][] = [];
        for (let r = 0; r < rows; r++) {
            for (let c= 0; c < cols; c++) {
                if (pacific[r][c] && atlantic[r][c]) {
                    results.push([r, c])
                }
            }
        }

        return results;

};