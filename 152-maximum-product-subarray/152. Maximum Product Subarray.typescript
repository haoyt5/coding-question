function maxProduct(nums: number[]): number {
    let curMax = nums[0];
    let curMin = nums[0];
    let result = nums[0];

    for (let i = 1; i < nums.length; i++) {
        let num = nums[i];

        if (num < 0 ) {
            [curMax, curMin] = [curMin, curMax]
        }
        curMax = Math.max(num, curMax* num)
        curMin = Math.min(num, curMin* num)

        result = Math.max(result, curMax)
    }
    return result;
};