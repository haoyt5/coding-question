function lastStoneWeight(stones: number[]): number {
    const heap = new MaxHeap<number>();

    for (const stone of stones) {
        heap.push(stone);
    }
    while(heap.size() > 1) {
        const x = heap.pop();
        const y = heap.pop();

        if (x > y ) {
            heap.push(x-y)
        }
    }
    return heap.size() === 0 ? 0 : heap.top()
};