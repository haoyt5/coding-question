class MinStack {
    private stack: number[]
    private minLogStack: number[]

    constructor() {
        this.stack = [];
        this.minLogStack = [];
    }

    push(value: number): void {
        this.stack.push(value);
        const curMin: number = this.minLogStack.length > 0 ? Math.min(this.minLogStack[this.minLogStack.length - 1], value ) : value;
        this.minLogStack.push(curMin);
    }

    pop(): void {
        this.stack.pop();
        this.minLogStack.pop();
    }

    top(): number {
        return this.stack[this.stack.length - 1]
    }

    getMin(): number {
        return this.minLogStack[this.minLogStack.length - 1]
    }
}

/**
 * Your MinStack object will be instantiated and called as such:
 * var obj = new MinStack()
 * obj.push(value)
 * obj.pop()
 * var param_3 = obj.top()
 * var param_4 = obj.getMin()
 */