function uniquePaths(m: number, n: number): number {
      // dp[i][j] = number of unique paths to reach cell (i, j)
  const dp = Array(m).fill(null).map(() => Array(n).fill(0));

  // Top row: only reachable by going right → 1 path each
  for (let col = 0; col < n; col++) dp[0][col] = 1;

  // Left col: only reachable by going down → 1 path each
  for (let row = 0; row < m; row++) dp[row][0] = 1;

  // Every other cell: sum of paths from above and from left
  for (let row = 1; row < m; row++) {
    for (let col = 1; col < n; col++) {
      dp[row][col] = dp[row - 1][col] + dp[row][col - 1];
    }
  }

  return dp[m - 1][n - 1];

};