function dailyTemperatures(temperatures: number[]): number[] {
    const n: number = temperatures.length
    const answers: number[] = new Array(n).fill(0)
    const stack: number[] = []; // unprocess(hasn't met the hight heat) index;
    for (let i = 0; i < temperatures.length; i++) {
        while(stack.length > 0 && temperatures[i] > temperatures[stack[stack.length - 1]]){
            const consumedIdx: number = stack.pop();
            const diff: number = i - consumedIdx;
            answers[consumedIdx] = diff;

        }
        stack.push(i)
    }
    
    return answers
};