function minInterval(intervals: number[][], queries: number[]): number[] {
    intervals.sort((a, b)=> a[0]-b[0]);
    const sortedQ = queries.map((val, idx)=> [val, idx]).sort((a, b)=> a[0]-b[0])
    const result = new Array(queries.length).fill(-1);
    const heap = new Heap<[number, number]>((a, b)=> a[0]-b[0]) // [size, right] sort by size

    let i = 0;

    for (const [q, qIdx] of sortedQ ) {
        while (i < intervals.length && intervals[i][0] <= q) {
            const [left, right] = intervals[i];
            heap.push([right - left + 1, right]);
            i++
        }


        while(heap.size()> 0 && heap.top()![1] < q) {
            heap.pop()
        }

        if (heap.size() > 0) {
            result[qIdx] = heap.top()![0]
        }
    }
    return result
};